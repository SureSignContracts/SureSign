APP_NAME="SureSign Contracts"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ── Demo environment (php artisan demo:seed / demo:reset) ────────────────────
# Isolated database connection for the demo company (Halden Grove
# Construction Ltd.) — see internal-docs/demo-environment/index.md. Defaults
# to the same host/credentials as DB_* above but a separate schema, so these
# only need setting to point the demo at genuinely separate infrastructure.
# DEMO_DB_HOST=127.0.0.1
# DEMO_DB_PORT=3306
# DEMO_DB_DATABASE=suresign_demo
# DEMO_DB_USERNAME=root
# DEMO_DB_PASSWORD=

# Isolated filesystem root for demo-generated files (payment application
# workbooks etc.) — see App\Support\Demo\DemoStorage. Defaults to
# storage/app/demo-private, kept separate from real customer files.
# DEMO_STORAGE_ROOT=/var/www/html/storage/app/demo-private

# The demo environment's own "today" — every Story class was authored
# against this fixed date. See App\Support\Demo\DemoClock. Only change
# this when deliberately rolling the whole story forward.
# DEMO_ANCHOR_DATE=2026-07-22

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MARKETING_CONTACT_EMAIL="tech@suresigncontracts.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── DatabaseSeeder initial account credentials ────────────────────────────────
# Optional. If left unset, php artisan db:seed generates a random temporary
# password for each account (printed once to the console) and flags the
# account to force a password change on first login. Only used the first time
# each account is created — safe to leave unset on repeat seed runs.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_GRAHAM_EMAIL=
SEED_GRAHAM_PASSWORD=

# ── Subscription & Billing (Stripe) ──────────────────────────────────────────
# See config/billing.php and internal-docs/super-admin/subscription-billing.md.
# Deliberately env-only, never stored in suresign_settings like the
# Anthropic/Brevo keys are — Stripe secret/webhook keys are a different risk
# class (direct financial exposure), so they're a boot-time/infra concern,
# not a Super Admin-editable database value.
#
# BILLING_ENABLED and BILLING_ENFORCEMENT_ENABLED must stay false until a
# deliberate go-live decision — see the Phase 0/Phase 18 live-mode
# readiness checklist. Never set true keys here; this file is committed.
BILLING_PROVIDER=stripe
BILLING_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false

STRIPE_KEY=
STRIPE_SECRET=
# Separate signing secret per Stripe webhook endpoint (test-mode and
# live-mode endpoints are registered separately in the Stripe Dashboard,
# each issuing its own secret) — WebhookIngestionService selects exactly
# one based on the app's own currently-configured mode, never both. Local
# Stripe CLI forwarding (`stripe listen`) must use STRIPE_WEBHOOK_SECRET_TEST
# against a test-mode-configured deployment/environment.
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_API_VERSION=

BILLING_DEFAULT_CURRENCY=GBP
# Full, absolute frontend URLs — CheckoutSessionService validates these via
# App\Rules\SafeUrl (https:// required, except http:// which is additionally
# allowed only in local/testing). Never left to a caller-supplied value.
# e.g. BILLING_CHECKOUT_SUCCESS_URL=https://app.suresigncontracts.com/app/settings/billing/checkout/success
BILLING_CHECKOUT_SUCCESS_URL=
BILLING_CHECKOUT_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=

BILLING_TRIAL_DAYS=0
BILLING_GRACE_PERIOD_DAYS=7
# The moment immutable entitlement snapshots became available in this
# codebase (Subscription Commercial State Automation checkpoint) — a fixed
# boundary, never a fabricated per-row value. See
# App\Services\Entitlements\SnapshotIntegrityClassifier.
BILLING_ENTITLEMENT_SNAPSHOT_INTRODUCED_AT="2026-07-23 00:00:00"

# Local/testing environments refuse to boot with a live-looking Stripe key
# (sk_live_/pk_live_) unless this is explicitly set — see
# App\Support\Billing\BillingConfigGuard. Never enable this in CI.
BILLING_ALLOW_LIVE_KEYS_IN_TESTING=false
